<?xml version="1.0" encoding="UTF-8"?>
<!--
  ContextMintBridgeMac: the App Sandbox (the Mac App Store requires it) and
  nothing else — no network (the app makes no connection; the extension's
  traffic is Safari's), no App Group or keychain group (nothing passes between
  the app and the appex), so the App ID needs no capability (plan D2).
  Applied only when a build signs.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
