{
  "name": "contextmint-bridge",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/extension-core && tsc -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  },
  "license": "MIT",
  "version": "1.7.2"
}
