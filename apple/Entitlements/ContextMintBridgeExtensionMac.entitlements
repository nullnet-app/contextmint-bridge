<?xml version="1.0" encoding="UTF-8"?>
<!--
  ContextMintBridgeExtensionMac: the App Sandbox, which every Safari appex
  must have, and nothing else (plan D2). Safari gives the extension its
  network and storage; the appex's own code needs neither.
  Applied only when a build signs.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
